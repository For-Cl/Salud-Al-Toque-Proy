# URL base del backend Spring Boot para la app React Native (Expo)
# - Dispositivo físico (Expo Go en tu celular): usa la IP local de tu PC (ej. http://192.168.18.126:8080)
# - Emulador Android (Android Studio): usa http://10.0.2.2:8080
# - Simulador iOS: usa http://localhost:8080
# - Servidor en la nube (AWS EC2): usa http://<IP-PUBLICA-EC2>:8080
EXPO_PUBLIC_API_URL=http://192.168.18.126:8080

